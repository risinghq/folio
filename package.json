{
  "name": "@risinghq/folio",
  "version": "0.0.1",
  "description": "A documentation site from a repository's docs folder, built with Vite and Solid.",
  "homepage": "https://folio.rising.sh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risinghq/folio.git"
  },
  "bin": {
    "folio": "dist/cli.js"
  },
  "files": [
    "dist",
    "theme"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./theme.css": "./theme/index.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "bun run build",
    "check": "bun run lint && bun run typecheck && bun run build && bun run test",
    "fix": "oxlint --fix && oxfmt",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "site": "vite site",
    "build:site": "bun run build && vite build site",
    "deploy:site": "wrangler deploy -c site/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/langs": "^4.6.0",
    "image-size": "^2.1.0",
    "marked": "^18.2.0",
    "satori": "^0.63.2",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.7",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "solid-js": "^2.0.0-rc.21",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.168.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "solid-js": "^2.0.0-rc.21",
    "vite": "^8.3.8"
  }
}
