{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "folio-site",
  "compatibility_date": "2026-11-01",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/docs/*"],
  },
  "routes": [{ "pattern": "folio.rising.sh", "custom_domain": true }],
}
